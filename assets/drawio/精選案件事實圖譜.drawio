ackgroundColor=#080d16;" edge="1" parent="1" source="n7" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="結果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n1" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="case-04-reference-4" name="案例 04｜參考 4"><mxGraphModel dx="3170" dy="1370" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3170" pageHeight="1370" background="#080d16"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n0" value="&lt;b&gt;被告&lt;/b&gt;&lt;br&gt;被告" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#cfe2cc;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="50" y="570" width="200" height="200" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;被害主體&lt;/b&gt;&lt;br&gt;被害主體" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#cfe2cc;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2500" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;犯罪原因&lt;/b&gt;&lt;br&gt;因返還欠款並取回抵&lt;br&gt;押之西藏獒犬遭拒絕&lt;br&gt;後與店家發生債務…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="100" width="200" height="200" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;犯罪工具&lt;/b&gt;&lt;br&gt;螺絲起子、掃把、垃&lt;br&gt;圾桶及徒手" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#00a000;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="1050" width="200" height="200" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告在店內拿起茶几&lt;br&gt;上的螺絲起子插在茶&lt;br&gt;几上並恫稱要將螺…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="650" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告以螺絲起子握柄&lt;br&gt;敲打被害主體頭部" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1020" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告與同夥中2人徒&lt;br&gt;手及持掃把、垃圾桶&lt;br&gt;攻擊被害主體頭部…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1390" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;同夥對被害主體之子&lt;br&gt;及店員出言恐嚇如打&lt;br&gt;電話報警下場將與…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1760" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告與同夥1人在離&lt;br&gt;去時未經被害主體同&lt;br&gt;意自店內冰箱取用…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2130" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;後果評估&lt;/b&gt;&lt;br&gt;結果情形：被害主體&lt;br&gt;之一受有頭部挫傷及&lt;br&gt;腦震盪；被害主體…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ff7200;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2870" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="e0" value="驅動" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n0" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="使用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n0" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="行為" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n0" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="發生" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengH