try x="300" y="100" width="200" height="200" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;犯罪工具&lt;/b&gt;&lt;br&gt;自小客車" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#00a000;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="1050" width="200" height="200" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告駕駛自小客車沿&lt;br&gt;設有劃分島之快車道&lt;br&gt;由東往西方向行駛" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="650" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告於快車道行駛時&lt;br&gt;疏未注意遵守不得右&lt;br&gt;轉彎之規定" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1020" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告自快車道向右轉&lt;br&gt;欲進入陽明路段" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1390" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被害主體騎乘普通重&lt;br&gt;型機車沿同路段之慢&lt;br&gt;車道由東往西方向…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1760" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被害主體見狀煞車閃&lt;br&gt;避不及與被告所駕自&lt;br&gt;小客車發生碰撞" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2130" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告於警方據報到場&lt;br&gt;處理時在場並當場承&lt;br&gt;認為肇事人" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2130" y="750" width="200" height="200" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;後果評估&lt;/b&gt;&lt;br&gt;結果情形：被害主體&lt;br&gt;人車倒地；左手腕遠&lt;br&gt;端橈骨粉碎性骨折…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ff7200;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2870" y="750" width="200" height="200" as="geometry" /></mxCell><mxCell id="e0" value="驅動" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n0" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="使用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n0" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id=