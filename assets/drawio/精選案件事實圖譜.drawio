"geometry" /></mxCell><mxCell id="e9" value="損害" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n3" target="n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400.0" y="1320" /><mxPoint x="2600.0" y="1320" /></Array></mxGeometry></mxCell><mxCell id="e10" value="造成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n7" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="結果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#080d16;" edge="1" parent="1" source="n1" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="case-04-reference-5" name="案例 04｜參考 5"><mxGraphModel dx="3170" dy="1370" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3170" pageHeight="1370" background="#080d16"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n0" value="&lt;b&gt;被告&lt;/b&gt;&lt;br&gt;被告" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#cfe2cc;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="50" y="570" width="200" height="200" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;被害主體&lt;/b&gt;&lt;br&gt;被害主體" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#cfe2cc;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2500" y="750" width="200" height="200" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;犯罪原因&lt;/b&gt;&lt;br&gt;因債務糾紛及被害主&lt;br&gt;體對友人出言不遜而&lt;br&gt;約定前往宮廟談判" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="100" width="200" height="200" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;犯罪工具&lt;/b&gt;&lt;br&gt;徒手、小武士刀、木&lt;br&gt;棍、自用小客車" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#00a000;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#ffffff;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="1050" width="200" height="200" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告與他人於至揚宮&lt;br&gt;會面時，徒手及由共&lt;br&gt;犯持木棍共同毆打…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="650" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告持小武士刀砍削&lt;br&gt;被害主體" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1020" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;在場他人將他人送醫&lt;br&gt;後，共犯持木棍及被&lt;br&gt;告持小武士刀與他…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1390" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告與共犯在車內挾&lt;br&gt;持被害主體，並共同&lt;br&gt;指示駕駛人駕駛自…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1760" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;被告與共犯抵達王功&lt;br&gt;燈塔後將被害主體拉&lt;br&gt;下車，與預先聯繫…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2130" y="390" width="200" height="200" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;涉案行為&lt;/b&gt;&lt;br&gt;嗣後被告與共犯以自&lt;br&gt;用小客車將被害主體&lt;br&gt;載回統一超商旁釋…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffff8a;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2130" y="750" width="200" height="200" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;後果評估&lt;/b&gt;&lt;br&gt;結果情形：被害主體&lt;br&gt;一度無法自行離去，&lt;br&gt;遭押往王功燈塔後…" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ff7200;strokeColor=#e5e7eb;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft JhengHei;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2870" y="750" width="200" height="200" as="geometry" /></mxCell><mxCell id="e0" value="驅動" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#aab6c5;stroke